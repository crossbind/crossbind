+}
+
+/* Announcement bar: taller and bolder than the theme default so it is read before the page. */
+:root {
+    --docusaurus-announcement-bar-height: 48px;
+}
+
+div[class*='announcementBar_'] {
+    height: auto;
+    padding: 11px 16px;
+    font-size: 16px;
+    line-height: 1.4;
+    font-weight: 600;
+    letter-spacing: 0.1px;
+    border-bottom: 2px solid #c98b00;
+}
+
+div[class*='announcementBar_'] a {
+    color: inherit;
+    font-weight: 800;
+    text-decoration: underline;
+    text-underline-offset: 3px;
+}
diff --git a/website/static/notice.js b/website/static/notice.js
new file mode 100644
index 00000000..171abb99
--- /dev/null
+++ b/website/static/notice.js
@@ -0,0 +1,7 @@
+// The announcement bar is one string for every page; this resolves its first link to the same
+// path on crossbind.dev at click time, so it follows the reader through client-side navigation.
+// The trailing slash is dropped because the new site's redirect rules are written without one.
+document.addEventListener('click', (event) => {
+    const link = event.target.closest('#cppjs-new-site');
+    if (link) link.href = `https://crossbind.dev${location.pathname.replace(/\/+$/, '')}`;
+});
