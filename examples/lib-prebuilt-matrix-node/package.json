{
    "name": "@crossbind/example-lib-prebuilt-matrix-node",
    "version": "2.0.0-beta.62",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/examples/lib-prebuilt-matrix-node#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(MIT OR NCSA) AND MIT",
    "description": "crossbind sample ready-made Node package: the matrix multiplier of @crossbind/example-lib-prebuilt-matrix with prebuilt Node-API addons for macOS, Linux and Windows.",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "exports": {
        "./*.h": {
            "types": "./dist/*.h.d.cts",
            "default": "./dist/*.h.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.cjs",
        "dist/**/*.d.cts",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin,linux,linuxmusl,win32 -e node -b release && node ../../scripts/stage-node-addons.mjs",
        "clear": "rm -rf .crossbind dist",
        "e2e": "node ../../scripts/e2e-node-package.mjs",
        "prepack": "node ../../scripts/check-node-package.mjs"
    },
    "optionalDependencies": {
        "@crossbind/example-lib-prebuilt-matrix-node-darwin-arm64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-darwin-x64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-linux-arm64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-linux-x64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-linuxmusl-arm64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-linuxmusl-x64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-win32-arm64": "workspace:*",
        "@crossbind/example-lib-prebuilt-matrix-node-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/example-lib-prebuilt-matrix": "workspace:^"
    },
    "keywords": [
        "crossbind-sample",
        "matrix",
        "node",
        "node-api",
        "prebuilt"
    ]
}
