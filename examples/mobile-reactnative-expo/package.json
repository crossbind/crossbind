{
    "name": "@crossbind/example-mobile-reactnative-expo",
    "private": true,
    "main": "expo-router/entry",
    "version": "0.0.0",
    "description": "crossbind Expo sample",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/examples/mobile-reactnative-expo#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "scripts": {
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "run:ios": "expo run:ios --no-bundler --configuration Release",
        "run:android": "expo run:android --no-bundler --variant release",
        "maestro:ios": "maestro --device \"$(xcrun simctl list devices booted | sed -n 's/.*(\\([0-9A-F-]\\{36\\}\\)) (Booted).*/\\1/p' | head -1)\" test ./maestro.yaml",
        "maestro:android": "maestro --device \"$(adb devices | sed -n '2p' | cut -f1)\" test ./maestro.yaml",
        "e2e:ios": "npm run run:ios && npm run maestro:ios",
        "e2e:android": "npm run run:android && npm run maestro:android"
    },
    "dependencies": {
        "@crossbind/core-embind-jsi": "2.0.0-beta.60",
        "@crossbind/plugin-react-native": "2.0.0-beta.60",
        "@crossbind/plugin-react-native-ios-helper": "2.0.0-beta.60",
        "@crossbind/example-lib-prebuilt-matrix": "2.0.0-beta.60",
        "hermes-compiler": "*",
        "expo": "~57.0.24",
        "expo-constants": "~57.0.19",
        "expo-device": "~57.0.2",
        "expo-font": "~57.0.4",
        "expo-glass-effect": "~57.0.3",
        "expo-image": "~57.0.5",
        "expo-linking": "~57.0.10",
        "expo-router": "~58.0.3",
        "expo-splash-screen": "~57.0.9",
        "expo-status-bar": "~57.0.1",
        "expo-symbols": "~57.0.3",
        "expo-system-ui": "~57.0.4",
        "expo-web-browser": "~57.0.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1"
    },
    "devDependencies": {
        "@types/react": "~19.2.18",
        "typescript": "~6.0.3",
        "@crossbind/typescript-config": "2.0.0-beta.60",
        "@crossbind/plugin-metro": "2.0.0-beta.60"
    },
    "overrides": {
        "uuid": "11.1.1",
        "replace": {
            "minimatch": "3.1.4"
        },
        "brace-expansion@5": "^5.0.9",
        "shell-quote": "^1.10.0",
        "js-yaml@4": "^4.3.1",
        "nanoid@3": "^3.3.18",
        "postcss": "^8.5.26",
        "ws@7": "^7.5.13",
        "@babel/core@7": "^7.29.7"
    },
    "keywords": [
        "crossbind-sample",
        "react-native",
        "expo",
        "bind",
        "c++",
        "android",
        "ios",
        "mobile"
    ]
}
