{
    "name": "@crossbind/example-mobile-reactnative-expo",
    "private": true,
    "main": "expo-router/entry",
    "version": "0.0.0",
    "description": "crossbind Expo sample",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/examples/mobile-reactnative-expo#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "scripts": {
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "crossbind-metro prepare-web && expo start --web",
        "export:web": "crossbind-metro prepare-web && expo export -p web --clear && crossbind-metro export-web dist",
        "lint": "expo lint",
        "run:ios": "expo run:ios --no-bundler --configuration Release",
        "run:android": "expo run:android --no-bundler --variant release",
        "maestro:ios": "maestro --device \"$(xcrun simctl list devices booted | sed -n 's/.*(\\([0-9A-F-]\\{36\\}\\)) (Booted).*/\\1/p' | head -1)\" test ./maestro.yaml",
        "maestro:android": "maestro --device \"$(adb devices | sed -n '2p' | cut -f1)\" test ./maestro.yaml",
        "e2e:ios": "npm run run:ios && npm run maestro:ios",
        "e2e:android": "npm run run:android && npm run maestro:android"
    },
    "dependencies": {
        "@crossbind/core-embind-jsi": "workspace:^",
        "@crossbind/plugin-react-native": "workspace:^",
        "@crossbind/plugin-react-native-ios-helper": "workspace:^",
        "@crossbind/example-lib-prebuilt-matrix": "workspace:^",
        "hermes-compiler": "260318099.0.5",
        "expo": "~58.0.14",
        "expo-constants": "~58.0.12",
        "expo-device": "~58.0.5",
        "expo-font": "~58.0.8",
        "expo-glass-effect": "~58.0.4",
        "expo-image": "~58.0.15",
        "expo-linking": "~58.0.13",
        "expo-router": "~58.0.23",
        "expo-splash-screen": "~58.0.10",
        "expo-status-bar": "~58.0.3",
        "expo-symbols": "~58.0.4",
        "expo-system-ui": "~58.0.6",
        "expo-web-browser": "~58.0.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-web": "~0.21.4",
        "react-native-worklets": "0.13.0"
    },
    "devDependencies": {
        "@types/react": "~19.3.0",
        "typescript": "~6.0.3",
        "metro-config": "^0.87.1",
        "@crossbind/typescript-config": "workspace:^",
        "@crossbind/plugin-metro": "workspace:^"
    },
    "keywords": [
        "crossbind-sample",
        "react-native",
        "expo",
        "bind",
        "c++",
        "android",
        "ios",
        "mobile"
    ]
}
