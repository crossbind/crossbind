{
    "name": "@crossbind/example-lib-prebuilt-matrix",
    "version": "2.0.0-beta.62",
    "description": "crossbind sample prebuilt library: matrix multiplier",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/examples/lib-prebuilt-matrix#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "crossbind build",
        "builda": "crossbind build -p wasm -p android",
        "build:wasm": "crossbind build -p wasm",
        "build:android": "crossbind build -p android",
        "build:ios": "crossbind build -p ios",
        "build:darwin": "crossbind build -p darwin",
        "build:desktop": "crossbind build -p darwin,linux,linuxmusl,win32 -e node",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    },
    "keywords": [
        "crossbind-sample",
        "matrix",
        "crossbind-sample",
        "webassembly",
        "react-native",
        "node",
        "node-api"
    ],
    "types": "./dist/types/index.d.ts",
    "typesVersions": {
        "*": {
            "node/napi": [
                "./node/napi.d.ts"
            ],
            "node/wasm": [
                "./node/wasm.d.ts"
            ],
            "edge/wasm": [
                "./edge/wasm.d.ts"
            ],
            "*.h": [
                "./dist/types/index.d.ts"
            ]
        }
    }
}
