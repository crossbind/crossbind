{
    "name": "@crossbind/example-mobile-reactnative-cli",
    "private": true,
    "version": "0.0.0",
    "description": "crossbind React Native sample",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/examples/mobile-reactnative-cli#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "scripts": {
        "android": "react-native run-android",
        "ios": "react-native run-ios",
        "lint": "eslint .",
        "start": "react-native start",
        "test": "jest",
        "run:android": "react-native run-android --no-packager --mode Release",
        "run:ios": "react-native run-ios --no-packager --mode Release",
        "maestro:ios": "maestro --device \"$(xcrun simctl list devices booted | sed -n 's/.*(\\([0-9A-F-]\\{36\\}\\)) (Booted).*/\\1/p' | head -1)\" test ./maestro.yaml",
        "maestro:android": "maestro --device \"$(adb devices | sed -n '2p' | cut -f1)\" test ./maestro.yaml",
        "e2e:ios": "pnpm run run:ios && pnpm run maestro:ios",
        "e2e:android": "pnpm run run:android && pnpm run maestro:android"
    },
    "dependencies": {
        "@crossbind/core-embind-jsi": "workspace:^",
        "@crossbind/plugin-react-native": "workspace:^",
        "@crossbind/plugin-react-native-ios-helper": "workspace:^",
        "@crossbind/example-lib-prebuilt-matrix": "workspace:^",
        "react": "19.2.3",
        "react-native": "0.85.3",
        "react-native-safe-area-context": "^5.8.0",
        "hermes-compiler": "*"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/runtime": "^7.29.7",
        "@react-native-community/cli": "20.1.3",
        "@react-native-community/cli-platform-android": "20.1.3",
        "@react-native-community/cli-platform-ios": "20.1.3",
        "@react-native/babel-preset": "0.85.3",
        "@react-native/codegen": "0.85.3",
        "@react-native/eslint-config": "0.85.3",
        "@react-native/jest-preset": "0.85.3",
        "@react-native/gradle-plugin": "0.85.3",
        "@react-native/metro-config": "0.85.3",
        "@react-native/typescript-config": "0.85.3",
        "@types/jest": "^29.5.13",
        "@types/react": "^19.2.18",
        "@types/react-test-renderer": "^19.1.0",
        "eslint": "^8.19.0",
        "jest": "^29.6.3",
        "prettier": "3.9.6",
        "react-test-renderer": "19.2.3",
        "typescript": "^5.8.3",
        "@crossbind/plugin-metro": "workspace:^"
    },
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "crossbind-sample",
        "react-native",
        "bind",
        "c++",
        "android",
        "ios",
        "mobile"
    ]
}
