{
    "name": "@crossbind/extension-esbuild",
    "version": "2.0.0-beta.82",
    "description": "crossbind extension: crossbind() in esbuild's and Bun's plugin lists, for a web build.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/extensions/esbuild#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./crossbind.extension.js": "./crossbind.extension.js"
    },
    "files": [
        "crossbind.extension.js",
        "src"
    ],
    "crossbind": {
        "extension": "./crossbind.extension.js"
    },
    "dependencies": {
        "@crossbind/core-embind-rust": "workspace:^"
    },
    "peerDependencies": {
        "esbuild": ">=0.17.0"
    },
    "peerDependenciesMeta": {
        "esbuild": {
            "optional": true
        }
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    },
    "keywords": [
        "crossbind-extension",
        "crossbind",
        "integration",
        "esbuild",
        "bun"
    ]
}
