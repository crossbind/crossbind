    "description": "crossbind app extension: sends a Windows app's MSIX packages and listing to the Microsoft Store through Partner Center's submission API.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/extensions/microsoft-store#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./crossbind.extension.js": "./crossbind.extension.js",
        "./listing": "./src/msStoreListing.js"
    },
    "files": [
