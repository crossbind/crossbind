{
    "name": "@crossbind/extension-vite",
    "version": "2.0.0-beta.82",
    "description": "crossbind extension: crossbind() in Vite's plugin list, for a web build, an app's and a preview.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/extensions/vite#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./crossbind.extension.js": "./crossbind.extension.js"
    },
    "files": [
        "crossbind.extension.js",
        "src"
    ],
    "crossbind": {
        "extension": "./crossbind.extension.js"
    },
    "dependencies": {
        "@crossbind/core-embind-rust": "workspace:^",
        "@crossbind/extension-rollup": "workspace:^"
    },
    "peerDependencies": {
        "vite": ">=3.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "keywords": [
        "crossbind-extension",
        "crossbind",
        "integration",
        "vite"
    ]
