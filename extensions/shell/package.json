{
    "name": "@crossbind/extension-shell",
    "version": "2.0.0-beta.72",
    "description": "crossbind app extension: opens addresses and files outside the app, shows them in the file manager, moves them to the trash.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/extensions/shell#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./page": {
            "types": "./page.d.ts",
            "default": "./page.js"
        },
        "./crossbind.extension.js": "./crossbind.extension.js"
    },
    "files": [
        "crossbind.extension.js",
        "native",
        "page.d.ts",
        "page.js"
    ],
    "crossbind": {
        "extension": "./crossbind.extension.js"
    },
    "peerDependencies": {
        "crossbind": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    },
    "keywords": [
        "crossbind-extension",
        "crossbind",
        "system",
        "shell",
        "app"
    ]
}
