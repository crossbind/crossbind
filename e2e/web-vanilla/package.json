{
    "name": "@crossbind/e2e-web-vanilla",
    "version": "0.0.0",
    "private": true,
    "description": "crossbind Web Vanilla playground",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/e2e/web-vanilla#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "scripts": {
        "build": "crossbind build -p wasm -a wasm32 -r mt -e browser && mkdir -p dist/conformance && cp -R node_modules/@crossbind/conformance/spec/. dist/conformance/",
        "preview": "serve -c ./serve.json",
        "e2e:prod": "playwright test --config playwright.prod.config.cjs"
    },
    "dependencies": {
        "@crossbind/example-lib-prebuilt-matrix": "workspace:^",
        "@crossbind/port-curl-wasm": "workspace:^",
        "@crossbind/port-expat-wasm": "workspace:^",
        "@crossbind/port-gdal-wasm": "workspace:^",
        "@crossbind/port-geos-wasm": "workspace:^",
        "@crossbind/port-geotiff-wasm": "workspace:^",
        "@crossbind/port-iconv-wasm": "workspace:^",
        "@crossbind/port-openssl-wasm": "workspace:^",
        "@crossbind/port-proj-wasm": "workspace:^",
        "@crossbind/port-spatialite-wasm": "workspace:^",
        "@crossbind/port-sqlite3-wasm": "workspace:^",
        "@crossbind/port-tiff-wasm": "workspace:^",
        "@crossbind/port-webp-wasm": "workspace:^",
        "@crossbind/port-zlib-wasm": "workspace:^",
        "@crossbind/embind-rust-demo": "workspace:^",
        "@crossbind/conformance-rust": "workspace:^",
        "@crossbind/conformance": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "serve": "^14.2.6",
        "@playwright/test": "^1.63.0"
    },
    "keywords": [
        "crossbind-sample",
        "webassembly",
        "bind",
        "c++",
        "vanilla"
    ]
}
