{
    "name": "@crossbind/e2e-cli-native",
    "version": "0.0.0",
    "private": true,
    "description": "Native command playground: one main.cpp and the zlib port linked into Linux (glibc and musl), Windows and macOS executables.",
    "scripts": {
        "build": "crossbind build -p linux,linuxmusl,win32 -e native -b release",
        "build:darwin": "crossbind build -p darwin -e native -b release",
        "e2e:prod": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist"
    },
    "dependencies": {
        "@crossbind/port-zlib-darwin": "workspace:^",
        "@crossbind/port-zlib-linux": "workspace:^",
        "@crossbind/port-zlib-linuxmusl": "workspace:^",
        "@crossbind/port-zlib-win32": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
