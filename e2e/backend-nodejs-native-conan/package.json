{
    "name": "@crossbind/e2e-backend-nodejs-native-conan",
    "version": "0.0.0",
    "private": true,
    "description": "Conan packages in Node.js addons: zlib, libpng, fmt and libcurl behind one app header, linked into Linux (glibc and musl), Windows and macOS addons.",
    "license": "MIT",
    "scripts": {
        "build": "crossbind build -p linux,linuxmusl,win32 -e node -b release",
        "build:darwin": "crossbind build -p darwin -e node -b release",
        "start": "node src/index.mjs",
        "e2e:prod": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist"
    },
    "devDependencies": {
        "@crossbind/core-embind-napi": "workspace:^",
        "crossbind": "workspace:^"
    }
}
