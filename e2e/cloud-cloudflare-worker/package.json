        "@crossbind/port-geotiff-wasm": "workspace:^",
        "@crossbind/port-iconv-wasm": "workspace:^",
        "@crossbind/port-openssl-wasm": "workspace:^",
        "@crossbind/port-proj-wasm": "workspace:^",
