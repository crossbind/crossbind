{
    "name": "@crossbind/e2e-web-rspack",
    "version": "0.0.0",
    "private": true,
    "description": "crossbind Rspack Playground",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/e2e/web-rspack#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "scripts": {
        "dev": "cross-env NODE_ENV=development rspack serve",
        "build": "cross-env NODE_ENV=production rspack build",
        "preview": "serve dist -c ../serve.json",
        "e2e:dev": "playwright test --config playwright.dev.config.cjs",
        "e2e:prod": "playwright test --config playwright.prod.config.cjs"
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "@crossbind/embind-rust-demo": "workspace:^",
        "@crossbind/conformance": "workspace:^",
        "@crossbind/example-lib-prebuilt-matrix": "workspace:^",
        "@crossbind/port-curl-wasm": "workspace:^",
        "@crossbind/port-expat-wasm": "workspace:^",
        "@crossbind/port-gdal-wasm": "workspace:^",
        "@crossbind/port-geos-wasm": "workspace:^",
        "@crossbind/port-geotiff-wasm": "workspace:^",
        "@crossbind/port-iconv-wasm": "workspace:^",
        "@crossbind/port-openssl-wasm": "workspace:^",
        "@crossbind/port-proj-wasm": "workspace:^",
        "@crossbind/port-spatialite-wasm": "workspace:^",
        "@crossbind/port-sqlite3-wasm": "workspace:^",
        "@crossbind/port-tiff-wasm": "workspace:^",
        "@crossbind/port-webp-wasm": "workspace:^",
        "@crossbind/port-zlib-wasm": "workspace:^"
    },
    "devDependencies": {
        "@rspack/plugin-react-refresh": "^2.0.2",
        "@rspack/cli": "^2.1.8",
        "@rspack/core": "^2.1.8",
        "@rspack/dev-server": "^2.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "cross-env": "^10.1.0",
        "react-refresh": "^0.19.0",
        "@playwright/test": "^1.62.1",
        "serve": "^14.2.6",
        "@crossbind/plugin-webpack": "workspace:^",
        "@crossbind/plugin-webpack-loader": "workspace:^"
    },
    "keywords": [
        "crossbind-sample",
        "webassembly",
        "bind",
        "c++",
        "react",
        "rspack",
        "webpack"
    ]
}
