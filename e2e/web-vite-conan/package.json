{
    "name": "@crossbind/e2e-web-vite-conan",
    "version": "0.0.0",
    "private": true,
    "description": "crossbind Vite playground for Conan packages: zlib and libpng through conan: imports, fmt through an app header",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/e2e/web-vite-conan#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
