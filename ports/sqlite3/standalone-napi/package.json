{
    "name": "@crossbind/port-sqlite3-standalone-napi",
    "version": "2.0.0-beta.63",
    "nativeVersion": "3.53.4",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/sqlite3#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(MIT OR NCSA) AND blessing AND MIT",
    "description": "sqlite3 for Node.js with nothing to build: prebuilt Node-API addons for macOS, Linux and Windows, built with crossbind.",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "exports": {
        ".": {
            "types": "./dist/node/napi.d.mts",
            "default": "./dist/node/napi.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.cjs",
        "dist/node",
        "dist/data",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin,linux,linuxmusl,win32 -e node -b release && crossbind licenses -e node --package",
        "clear": "rm -rf .crossbind dist",
        "e2e": "node ../../../scripts/e2e-node-package.mjs",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "optionalDependencies": {
        "@crossbind/port-sqlite3-standalone-napi-darwin-arm64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-darwin-x64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-linux-arm64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-linux-x64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-linuxmusl-arm64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-linuxmusl-x64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-win32-arm64": "workspace:*",
        "@crossbind/port-sqlite3-standalone-napi-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:*",
        "@crossbind/port-sqlite3-darwin": "workspace:*",
        "@crossbind/port-sqlite3-linux": "workspace:*",
        "@crossbind/port-sqlite3-linuxmusl": "workspace:*",
        "@crossbind/port-sqlite3-win32": "workspace:*"
    },
    "keywords": [
        "sqlite",
        "sqlite3",
        "libsqlite3",
        "database",
        "sql",
        "crossbind",
        "crossbind-port",
        "node",
        "node-api",
        "prebuilt"
    ]
}
