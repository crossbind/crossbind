{
    "name": "@crossbind/port-sqlite3-standalone-napi-linuxmusl-x64",
    "version": "2.0.0-beta.62",
    "nativeVersion": "3.53.4",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/sqlite3#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(Apache-2.0 WITH LLVM-exception) AND (MIT OR NCSA) AND blessing AND MIT",
    "description": "Linux x64 (musl) addon of @crossbind/port-sqlite3-standalone-napi, which npm installs on a matching machine.",
    "os": [
        "linux"
    ],
    "cpu": [
        "x64"
    ],
    "libc": [
        "musl"
    ],
    "main": "dist/sqlite3-standalone-napi.linuxmusl-x64.node",
    "files": [
        "dist/sqlite3-standalone-napi.linuxmusl-x64.node",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p linuxmusl -a x64 -e node -b release && crossbind licenses --platform linuxmusl -e node --package",
        "clear": "rm -rf .crossbind dist",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-sqlite3-darwin": "workspace:^",
        "@crossbind/port-sqlite3-linux": "workspace:^",
        "@crossbind/port-sqlite3-linuxmusl": "workspace:^",
        "@crossbind/port-sqlite3-win32": "workspace:^"
    }
}
