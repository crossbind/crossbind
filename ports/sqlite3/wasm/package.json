{
    "name": "@crossbind/port-sqlite3-wasm",
    "version": "2.0.0-beta.53",
    "nativeVersion": "3.53.4",
    "description": "WebAssembly build of the precompiled SQLite3 database engine, built with crossbind. Use it together with the main package @crossbind/port-sqlite3.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/sqlite3#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "blessing",
    "type": "module",
    "scripts": {
        "build": "crossbind build -p wasm",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasm"
    },
    "dependencies": {
        "@crossbind/port-sqlite3": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    },
    "keywords": [
        "sqlite",
        "sqlite3",
