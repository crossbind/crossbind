{
    "name": "@crossbind/port-spatialite-linux",
    "version": "2.0.0-beta.62",
    "nativeVersion": "5.1.0",
    "description": "Linux build of the precompiled SpatiaLite (spatial SQLite extension) library, built with crossbind. Use it together with the main package @crossbind/port-spatialite.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/spatialite#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later",
    "keywords": [
        "spatialite",
        "libspatialite",
        "sqlite",
        "spatial",
        "gis",
        "crossbind",
        "crossbind-port",
        "linux",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p linux",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p linux"
    },
    "dependencies": {
        "@crossbind/port-spatialite": "workspace:^",
        "@crossbind/port-geos-linux": "workspace:^",
        "@crossbind/port-proj-linux": "workspace:^",
        "@crossbind/port-sqlite3-linux": "workspace:^",
        "@crossbind/port-zlib-linux": "workspace:^",
        "@crossbind/port-iconv-linux": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
