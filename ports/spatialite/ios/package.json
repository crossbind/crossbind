{
    "name": "@crossbind/port-spatialite-ios",
    "version": "2.0.0-beta.53",
    "nativeVersion": "5.1.0",
    "description": "iOS build of the precompiled SpatiaLite (spatial SQLite extension) library, built with crossbind. Use it together with the main package @crossbind/port-spatialite.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/spatialite#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later",
    "keywords": [
        "spatialite",
        "libspatialite",
        "sqlite",
        "spatial",
        "gis",
        "crossbind",
        "crossbind-port",
        "ios",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p ios",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p ios"
    },
    "dependencies": {
        "@crossbind/port-spatialite": "workspace:^",
        "@crossbind/port-geos-ios": "workspace:^",
        "@crossbind/port-proj-ios": "workspace:^",
        "@crossbind/port-sqlite3-ios": "workspace:^",
        "@crossbind/port-zlib-ios": "workspace:^",
        "@crossbind/port-iconv-ios": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}