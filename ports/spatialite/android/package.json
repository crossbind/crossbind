{
    "name": "@crossbind/port-spatialite-android",
    "version": "2.0.0-beta.50",
    "nativeVersion": "5.1.0",
    "description": "Android build of the precompiled SpatiaLite (spatial SQLite extension) library, built with crossbind. Use it together with the main package @crossbind/port-spatialite.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/spatialite#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MPL-1.1 OR GPL-2.0-or-later OR LGPL-2.1-or-later",
    "keywords": [
        "spatialite",
        "libspatialite",
        "sqlite",
        "spatial",
        "gis",
        "crossbind",
        "crossbind-package",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
    },
    "dependencies": {
        "@crossbind/port-spatialite": "workspace:^",
        "@crossbind/port-geos-android": "workspace:^",
        "@crossbind/port-proj-android": "workspace:^",
        "@crossbind/port-sqlite3-android": "workspace:^",
        "@crossbind/port-zlib-android": "workspace:^",
        "@crossbind/port-iconv-android": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}