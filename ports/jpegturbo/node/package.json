{
    "name": "@crossbind/port-jpegturbo-node",
    "version": "2.0.0-beta.62",
    "nativeVersion": "3.2.0",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/jpegturbo#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(IJG AND BSD-3-Clause AND Zlib) AND (MIT OR NCSA) AND MIT",
    "description": "jpegturbo for Node.js with nothing to build: prebuilt Node-API addons for macOS, Linux and Windows, built with crossbind.",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "exports": {
        "./*.h": {
            "types": "./dist/*.h.d.cts",
            "default": "./dist/*.h.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.cjs",
        "dist/**/*.d.cts",
        "dist/data",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin,linux,linuxmusl,win32 -e node -b release && node ../../../scripts/stage-node-addons.mjs",
        "clear": "rm -rf .crossbind dist",
        "e2e": "node ../../../scripts/e2e-node-package.mjs",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "optionalDependencies": {
        "@crossbind/port-jpegturbo-node-darwin-arm64": "workspace:*",
        "@crossbind/port-jpegturbo-node-darwin-x64": "workspace:*",
        "@crossbind/port-jpegturbo-node-linux-arm64": "workspace:*",
        "@crossbind/port-jpegturbo-node-linux-x64": "workspace:*",
        "@crossbind/port-jpegturbo-node-linuxmusl-arm64": "workspace:*",
        "@crossbind/port-jpegturbo-node-linuxmusl-x64": "workspace:*",
        "@crossbind/port-jpegturbo-node-win32-arm64": "workspace:*",
        "@crossbind/port-jpegturbo-node-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-jpegturbo-darwin": "workspace:^",
        "@crossbind/port-jpegturbo-linux": "workspace:^",
        "@crossbind/port-jpegturbo-linuxmusl": "workspace:^",
        "@crossbind/port-jpegturbo-win32": "workspace:^"
    },
    "keywords": [
        "jpegturbo",
        "libjpeg-turbo",
        "jpeg",
        "image",
        "crossbind",
        "crossbind-port",
        "node",
        "node-api",
        "prebuilt"
    ]
}
