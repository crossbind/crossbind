{
    "name": "@crossbind/port-jpegturbo-android",
    "version": "2.0.0-beta.50",
    "nativeVersion": "3.2.0",
    "description": "Android build of the precompiled libjpeg-turbo (JPEG) library, built with crossbind. Use it together with the main package @crossbind/port-jpegturbo.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/jpegturbo#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "(IJG AND BSD-3-Clause AND Zlib)",
    "keywords": [
        "jpegturbo",
        "libjpeg-turbo",
        "jpeg",
        "image",
        "crossbind",
        "crossbind-package",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
