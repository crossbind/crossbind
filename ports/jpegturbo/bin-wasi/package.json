{
    "name": "@crossbind/port-jpegturbo-bin-wasi",
    "version": "2.0.0-beta.37",
    "nativeVersion": "3.2.0",
    "description": "cjpeg/djpeg/jpegtran prebuilt as WASI (wasm32-wasip3) command components.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/jpegturbo#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
