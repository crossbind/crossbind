{
    "name": "@crossbind/port-jpegturbo-standalone-wasi",
    "version": "2.0.0-beta.75",
    "nativeVersion": "3.2.1",
    "description": "cjpeg/djpeg/jpegtran prebuilt as WASI (wasm32-wasip3) command components.",
