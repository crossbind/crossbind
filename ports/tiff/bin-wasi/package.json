{
    "name": "@crossbind/port-tiff-bin-wasi",
    "version": "2.0.0-beta.50",
    "nativeVersion": "4.7.2",
    "description": "libtiff command-line tools prebuilt as WASI (wasm32-wasip3) command components.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/tiff#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "(Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (Apache-2.0 WITH LLVM-exception) AND libtiff AND Zlib",
    "keywords": [
        "tiff",
        "libtiff",
        "cli",
        "crossbind",
        "crossbind-package",
        "webassembly",
        "wasi",
        "wasmtime"
    ],
    "scripts": {
        "build": "crossbind build -p wasi -b release",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasi -b release && crossbind licenses --sbom"
    },
    "dependencies": {
        "@crossbind/port-tiff": "workspace:^",
        "@crossbind/port-tiff-wasi": "workspace:^",
        "crossbind": "workspace:^"
    },
    "bin": {
        "fax2ps-wasi": "bin/fax2ps-wasi.mjs",
        "fax2tiff-wasi": "bin/fax2tiff-wasi.mjs",
        "pal2rgb-wasi": "bin/pal2rgb-wasi.mjs",
        "ppm2tiff-wasi": "bin/ppm2tiff-wasi.mjs",
        "raw2tiff-wasi": "bin/raw2tiff-wasi.mjs",
        "tiff2bw-wasi": "bin/tiff2bw-wasi.mjs",
        "tiff2pdf-wasi": "bin/tiff2pdf-wasi.mjs",
        "tiff2ps-wasi": "bin/tiff2ps-wasi.mjs",
        "tiff2rgba-wasi": "bin/tiff2rgba-wasi.mjs",
        "tiffcmp-wasi": "bin/tiffcmp-wasi.mjs",
        "tiffcp-wasi": "bin/tiffcp-wasi.mjs",
        "tiffcrop-wasi": "bin/tiffcrop-wasi.mjs",
        "tiffdither-wasi": "bin/tiffdither-wasi.mjs",
        "tiffdump-wasi": "bin/tiffdump-wasi.mjs",
        "tiffinfo-wasi": "bin/tiffinfo-wasi.mjs",
        "tiffmedian-wasi": "bin/tiffmedian-wasi.mjs",
        "tiffset-wasi": "bin/tiffset-wasi.mjs",
        "tiffsplit-wasi": "bin/tiffsplit-wasi.mjs"
    },
    "crossbind": {
        "provenance": {
            "recipe": {
                "name": "@crossbind/port-tiff",
                "version": "2.0.0-beta.50",
                "nativeVersion": "4.7.2"
            },
            "source": {
                "url": "https://download.osgeo.org/libtiff/tiff-4.7.2.tar.gz",
                "sha256": "672bd7d10aee4606171afb864f3570b83340f6a33e2c186dc0512f7145ffdf6a"
            },
            "environment": {
                "builder": "host",
                "dockerImage": "ghcr.io/crossbind/web@sha256:c1d1d81a4775871cd90c8ac980e0a5f87cb7890822117f77be1c8345f51b1f47",
                "hostPlatform": "darwin-arm64",
                "toolchain": {
                    "name": "wasi-sdk",
                    "version": "34.0-rc.3+m",
                    "wasi-libc": "2e6fb9d8ee0c",
                    "llvm": "7196f931f212",
                    "llvm-version": "23.1.0",
                    "config": "f992bcc08219",
                    "clangSha256": "82a4a3fa013d14978f98452bb76213a3212ee4f5d7937e493ab40724061be570"
                }
            },
            "sbom": "dist/prebuilt/wasi-wasm32-st-release/sbom.cdx.json"
        }
    }
}
