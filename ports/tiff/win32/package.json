{
    "name": "@crossbind/port-tiff-win32",
    "version": "2.0.0-beta.63",
    "nativeVersion": "4.7.2",
    "description": "Windows build of the precompiled TIFF (libtiff) image library, built with crossbind. Use it together with the main package @crossbind/port-tiff.",
    "homepage": "https://crossbind.dev/ports/tiff/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "libtiff",
    "keywords": [
        "tiff",
        "libtiff",
        "image",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-tiff": "workspace:^",
        "@crossbind/port-zlib-win32": "workspace:^",
        "@crossbind/port-jpegturbo-win32": "workspace:^",
        "@crossbind/port-zstd-win32": "workspace:^",
        "@crossbind/port-lerc-win32": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
