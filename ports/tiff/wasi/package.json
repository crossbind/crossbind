{
    "name": "@crossbind/port-tiff-wasi",
    "version": "2.0.0-beta.50",
    "nativeVersion": "4.7.2",
    "description": "WASI build of the precompiled TIFF (libtiff) image library, built with crossbind. Use it together with the main package @crossbind/port-tiff.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/tiff#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "libtiff",
    "keywords": [
        "tiff",
        "libtiff",
        "image",
        "crossbind",
        "crossbind-port",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "crossbind build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasi"
    },
    "dependencies": {
        "@crossbind/port-tiff": "workspace:^",
        "@crossbind/port-zlib-wasi": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
