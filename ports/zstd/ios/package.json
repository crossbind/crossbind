{
    "name": "@crossbind/port-zstd-ios",
    "version": "2.0.0-beta.53",
    "nativeVersion": "1.5.7",
    "description": "iOS build of the precompiled Zstandard (zstd) library, built with crossbind. Use it together with the main package @crossbind/port-zstd.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/zstd#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "BSD-3-Clause",
    "keywords": [
        "zstd",
        "zstandard",
        "libzstd",
        "compression",
        "crossbind",
        "crossbind-port",
        "ios",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p ios",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p ios"
    },
    "dependencies": {
        "@crossbind/port-zstd": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}