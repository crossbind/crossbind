{
    "name": "@crossbind/port-zstd-standalone-napi",
    "version": "2.0.0-beta.63",
    "nativeVersion": "1.5.7",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/zstd#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(BSD-3-Clause OR GPL-2.0-only) AND (MIT OR NCSA) AND MIT",
    "description": "zstd for Node.js with nothing to build: prebuilt Node-API addons for macOS, Linux and Windows, built with crossbind.",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "exports": {
        ".": {
            "types": "./dist/node/napi.d.mts",
            "default": "./dist/node/napi.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.cjs",
        "dist/node",
        "dist/data",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin,linux,linuxmusl,win32 -e node -b release && crossbind licenses -e node --package",
        "clear": "rm -rf .crossbind dist",
        "e2e": "node ../../../scripts/e2e-node-package.mjs",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "optionalDependencies": {
        "@crossbind/port-zstd-standalone-napi-darwin-arm64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-darwin-x64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-linux-arm64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-linux-x64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-linuxmusl-arm64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-linuxmusl-x64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-win32-arm64": "workspace:*",
        "@crossbind/port-zstd-standalone-napi-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-zstd-darwin": "workspace:^",
        "@crossbind/port-zstd-linux": "workspace:^",
        "@crossbind/port-zstd-linuxmusl": "workspace:^",
        "@crossbind/port-zstd-win32": "workspace:^"
    },
    "keywords": [
        "zstd",
        "zstandard",
        "libzstd",
        "compression",
        "crossbind",
        "crossbind-port",
        "node",
        "node-api",
        "prebuilt"
    ]
}
