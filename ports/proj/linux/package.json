{
    "name": "@crossbind/port-proj-linux",
    "version": "2.0.0-beta.63",
    "nativeVersion": "9.9.0",
    "description": "Linux build of the precompiled PROJ coordinate-transformation library, built with crossbind. Use it together with the main package @crossbind/port-proj.",
    "homepage": "https://crossbind.dev/ports/proj/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "proj",
        "libproj",
        "projection",
        "gis",
        "crossbind",
        "crossbind-port",
        "linux",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p linux",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p linux"
    },
    "dependencies": {
        "@crossbind/port-proj": "workspace:^",
        "@crossbind/port-tiff-linux": "workspace:^",
        "@crossbind/port-sqlite3-linux": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
