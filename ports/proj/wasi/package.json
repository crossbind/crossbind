{
    "name": "@crossbind/port-proj-wasi",
    "version": "2.0.0-beta.50",
    "nativeVersion": "9.8.1",
    "description": "WASI build of the precompiled PROJ coordinate-transformation library, built with crossbind. Use it together with the main package @crossbind/port-proj.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/proj#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "proj",
        "libproj",
        "projection",
        "gis",
        "crossbind",
        "crossbind-port",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "crossbind build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasi"
    },
    "dependencies": {
        "@crossbind/port-proj": "workspace:^",
        "@crossbind/port-tiff-wasi": "workspace:^",
        "@crossbind/port-sqlite3-wasi": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
