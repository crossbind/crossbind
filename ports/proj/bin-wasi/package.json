        "cs2cs-wasi": "bin/cs2cs-wasi.mjs",
        "geod-wasi": "bin/geod-wasi.mjs",
        "gie-wasi": "bin/gie-wasi.mjs",
        "projinfo-wasi": "bin/projinfo-wasi.mjs"
    },
    "crossbind": {
        "provenance": {
            "recipe": {
                "name": "@crossbind/port-proj",
