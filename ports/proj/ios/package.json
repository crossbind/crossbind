{
    "name": "@crossbind/port-proj-ios",
    "version": "2.0.0-beta.53",
    "nativeVersion": "9.8.1",
    "description": "iOS build of the precompiled PROJ coordinate-transformation library, built with crossbind. Use it together with the main package @crossbind/port-proj.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/proj#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "proj",
        "libproj",
        "projection",
        "gis",
        "crossbind",
        "crossbind-port",
        "ios",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p ios",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p ios"
    },
    "dependencies": {
        "@crossbind/port-proj": "workspace:^",
        "@crossbind/port-tiff-ios": "workspace:^",
        "@crossbind/port-sqlite3-ios": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}