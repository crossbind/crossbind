{
    "name": "@crossbind/port-proj-win32",
    "version": "2.0.0-beta.62",
    "nativeVersion": "9.9.0",
    "description": "Windows build of the precompiled PROJ coordinate-transformation library, built with crossbind. Use it together with the main package @crossbind/port-proj.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/proj#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "proj",
        "libproj",
        "projection",
        "gis",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-proj": "workspace:^",
        "@crossbind/port-tiff-win32": "workspace:^",
        "@crossbind/port-sqlite3-win32": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
