{
    "name": "@crossbind/port-expat-wasi",
    "version": "2.0.0-beta.50",
    "nativeVersion": "2.8.3",
    "description": "WASI build of the precompiled Expat XML parser library, built with crossbind. Use it together with the main package @crossbind/port-expat.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/expat#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "expat",
        "libexpat",
        "xml",
        "crossbind",
        "crossbind-package",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "crossbind build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasi"
    },
    "dependencies": {
        "@crossbind/port-expat": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
