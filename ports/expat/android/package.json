{
    "name": "@crossbind/port-expat-android",
    "version": "2.0.0-beta.50",
    "nativeVersion": "2.8.3",
    "description": "Android build of the precompiled Expat XML parser library, built with crossbind. Use it together with the main package @crossbind/port-expat.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/expat#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "expat",
        "libexpat",
        "xml",
        "crossbind",
        "crossbind-package",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
    },
    "dependencies": {
        "@crossbind/port-expat": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
