{
    "name": "@crossbind/port-openssl-standalone-napi-darwin-x64",
    "version": "2.0.0-beta.63",
    "nativeVersion": "4.0.3",
    "homepage": "https://crossbind.dev/ports/openssl/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(MIT OR NCSA) AND Apache-2.0 AND MIT",
    "description": "macOS x64 addon of @crossbind/port-openssl-standalone-napi, which npm installs on a matching machine.",
    "os": [
        "darwin"
    ],
    "cpu": [
        "x64"
    ],
    "main": "dist/openssl-standalone-napi.darwin-x64.node",
    "files": [
        "dist/openssl-standalone-napi.darwin-x64.node",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin -a x64 -e node -b release && crossbind licenses --platform darwin -e node --package",
        "clear": "rm -rf .crossbind dist",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-openssl-darwin": "workspace:^",
        "@crossbind/port-openssl-linux": "workspace:^",
        "@crossbind/port-openssl-linuxmusl": "workspace:^",
        "@crossbind/port-openssl-win32": "workspace:^"
    }
}
