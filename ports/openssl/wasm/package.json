{
    "name": "@crossbind/port-openssl-wasm",
    "version": "2.0.0-beta.53",
    "nativeVersion": "4.0.2",
    "description": "WebAssembly build of the precompiled OpenSSL library, built with crossbind. Use it together with the main package @crossbind/port-openssl.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/openssl#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "openssl",
        "ssl",
        "libssl",
        "crypto",
        "libcrypto",
        "crossbind",
        "crossbind-port",
        "webassembly",
        "wasm"
    ],
    "scripts": {
        "build": "crossbind build -p wasm",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p wasm"
    },
    "dependencies": {
        "@crossbind/port-openssl": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}