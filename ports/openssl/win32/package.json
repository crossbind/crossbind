{
    "name": "@crossbind/port-openssl-win32",
    "version": "2.0.0-beta.63",
    "nativeVersion": "4.0.3",
    "description": "Windows build of the precompiled OpenSSL library, built with crossbind. Use it together with the main package @crossbind/port-openssl.",
    "homepage": "https://crossbind.dev/ports/openssl/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "openssl",
        "ssl",
        "libssl",
        "crypto",
        "libcrypto",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-openssl": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
