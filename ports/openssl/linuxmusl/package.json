{
    "name": "@crossbind/port-openssl-linuxmusl",
    "version": "2.0.0-beta.62",
    "nativeVersion": "4.0.3",
    "description": "Linux (musl) build of the precompiled OpenSSL library, built with crossbind. Use it together with the main package @crossbind/port-openssl.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/openssl#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "openssl",
        "ssl",
        "libssl",
        "crypto",
        "libcrypto",
        "crossbind",
        "crossbind-port",
        "linux",
        "musl",
        "alpine",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p linuxmusl",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p linuxmusl"
    },
    "dependencies": {
        "@crossbind/port-openssl": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
