{
    "name": "@crossbind/port-openssl-standalone-napi-linux-x64",
    "version": "2.0.0-beta.63",
    "nativeVersion": "4.0.3",
    "homepage": "https://crossbind.dev/ports/openssl/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(Apache-2.0 WITH LLVM-exception) AND (MIT OR NCSA) AND Apache-2.0 AND MIT",
    "description": "Linux x64 (glibc) addon of @crossbind/port-openssl-standalone-napi, which npm installs on a matching machine.",
    "os": [
        "linux"
    ],
    "cpu": [
        "x64"
    ],
    "libc": [
        "glibc"
    ],
    "main": "dist/openssl-standalone-napi.linux-x64.node",
    "files": [
        "dist/openssl-standalone-napi.linux-x64.node",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p linux -a x64 -e node -b release && crossbind licenses --platform linux -e node --package",
        "clear": "rm -rf .crossbind dist",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-openssl-darwin": "workspace:^",
        "@crossbind/port-openssl-linux": "workspace:^",
        "@crossbind/port-openssl-linuxmusl": "workspace:^",
        "@crossbind/port-openssl-win32": "workspace:^"
    }
}
