{
    "name": "@crossbind/port-lerc-linuxmusl",
    "version": "2.0.0-beta.63",
    "nativeVersion": "4.2.0",
    "description": "Linux (musl) build of the precompiled LERC (Limited Error Raster Compression) library, built with crossbind. Use it together with the main package @crossbind/port-lerc.",
    "homepage": "https://crossbind.dev/ports/lerc/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "lerc",
        "libLerc",
        "raster-compression",
        "crossbind",
        "crossbind-port",
        "linux",
        "musl",
        "alpine",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p linuxmusl",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p linuxmusl"
    },
    "dependencies": {
        "@crossbind/port-lerc": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
