{
    "name": "@crossbind/port-lerc-android",
    "version": "2.0.0-beta.53",
    "nativeVersion": "4.2.0",
    "description": "Android build of the precompiled LERC (Limited Error Raster Compression) library, built with crossbind. Use it together with the main package @crossbind/port-lerc.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/lerc#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "lerc",
        "libLerc",
        "raster-compression",
        "crossbind",
        "crossbind-port",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
    },
    "dependencies": {
        "@crossbind/port-lerc": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}