{
    "name": "@crossbind/port-lerc-darwin",
    "version": "2.0.0-beta.62",
    "nativeVersion": "4.2.0",
    "description": "macOS build of the precompiled LERC (Limited Error Raster Compression) library, built with crossbind. Use it together with the main package @crossbind/port-lerc.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/lerc#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "lerc",
        "libLerc",
        "raster-compression",
        "crossbind",
        "crossbind-port",
        "macos",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p darwin",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p darwin"
    },
    "dependencies": {
        "@crossbind/port-lerc": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
