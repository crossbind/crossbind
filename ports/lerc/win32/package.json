{
    "name": "@crossbind/port-lerc-win32",
    "version": "2.0.0-beta.63",
    "nativeVersion": "4.2.0",
    "description": "Windows build of the precompiled LERC (Limited Error Raster Compression) library, built with crossbind. Use it together with the main package @crossbind/port-lerc.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/lerc#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "Apache-2.0",
    "keywords": [
        "lerc",
        "libLerc",
        "raster-compression",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-lerc": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:*"
    }
}
