{
    "name": "@crossbind/port-gdal-android",
    "version": "2.0.0-beta.50",
    "nativeVersion": "3.13.3",
    "description": "Android build of the precompiled GDAL geospatial library, built with crossbind. Use it together with the main package @crossbind/port-gdal.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/gdal#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "gdal",
        "libgdal",
        "gis",
        "geospatial",
        "raster",
        "vector",
        "crossbind",
        "crossbind-package",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
    },
    "dependencies": {
        "@crossbind/port-gdal": "workspace:^",
        "@crossbind/port-curl-android": "workspace:^",
        "@crossbind/port-expat-android": "workspace:^",
        "@crossbind/port-geos-android": "workspace:^",
        "@crossbind/port-geotiff-android": "workspace:^",
        "@crossbind/port-iconv-android": "workspace:^",
        "@crossbind/port-jpegturbo-android": "workspace:^",
        "@crossbind/port-proj-android": "workspace:^",
        "@crossbind/port-spatialite-android": "workspace:^",
        "@crossbind/port-sqlite3-android": "workspace:^",
        "@crossbind/port-tiff-android": "workspace:^",
        "@crossbind/port-webp-android": "workspace:^",
        "@crossbind/port-zlib-android": "workspace:^",
        "@crossbind/port-zstd-android": "workspace:^",
        "@crossbind/port-lerc-android": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
