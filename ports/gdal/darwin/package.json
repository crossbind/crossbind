{
    "name": "@crossbind/port-gdal-darwin",
    "version": "2.0.0-beta.62",
    "nativeVersion": "3.13.3",
    "description": "macOS build of the precompiled GDAL geospatial library, built with crossbind. Use it together with the main package @crossbind/port-gdal.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/gdal#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "gdal",
        "libgdal",
        "gis",
        "geospatial",
        "raster",
        "vector",
        "crossbind",
        "crossbind-port",
        "macos",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p darwin",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p darwin"
    },
    "dependencies": {
        "@crossbind/port-gdal": "workspace:^",
        "@crossbind/port-curl-darwin": "workspace:^",
        "@crossbind/port-expat-darwin": "workspace:^",
        "@crossbind/port-geos-darwin": "workspace:^",
        "@crossbind/port-geotiff-darwin": "workspace:^",
        "@crossbind/port-iconv-darwin": "workspace:^",
        "@crossbind/port-jpegturbo-darwin": "workspace:^",
        "@crossbind/port-proj-darwin": "workspace:^",
        "@crossbind/port-spatialite-darwin": "workspace:^",
        "@crossbind/port-sqlite3-darwin": "workspace:^",
        "@crossbind/port-tiff-darwin": "workspace:^",
        "@crossbind/port-webp-darwin": "workspace:^",
        "@crossbind/port-zlib-darwin": "workspace:^",
        "@crossbind/port-zstd-darwin": "workspace:^",
        "@crossbind/port-lerc-darwin": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
