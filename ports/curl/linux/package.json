{
    "name": "@crossbind/port-curl-linux",
    "version": "2.0.0-beta.63",
    "nativeVersion": "8.22.0",
    "description": "Linux build of the precompiled libcurl (CURL) library, built with crossbind. Use it together with the main package @crossbind/port-curl.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/curl#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "curl",
    "keywords": [
        "curl",
        "libcurl",
        "http",
        "networking",
        "crossbind",
        "crossbind-port",
        "linux",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p linux",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p linux"
    },
    "dependencies": {
        "@crossbind/port-curl": "workspace:^",
        "@crossbind/port-openssl-linux": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
