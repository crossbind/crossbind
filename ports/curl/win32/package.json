{
    "name": "@crossbind/port-curl-win32",
    "version": "2.0.0-beta.62",
    "nativeVersion": "8.22.0",
    "description": "Windows build of the precompiled libcurl (CURL) library, built with crossbind. Use it together with the main package @crossbind/port-curl.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/curl#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "curl",
    "keywords": [
        "curl",
        "libcurl",
        "http",
        "networking",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-curl": "workspace:^",
        "@crossbind/port-openssl-win32": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
