{
    "name": "@crossbind/port-curl-wasi",
    "version": "2.0.0-beta.53",
    "nativeVersion": "8.21.0",
    "description": "WASI build of the precompiled libcurl (CURL) library, built with crossbind. Use it together with the main package @crossbind/port-curl.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/curl#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "curl",
    "keywords": [
        "curl",
        "libcurl",
        "http",
        "networking",
        "crossbind",
        "crossbind-port",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "crossbind build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasi"
    },
    "dependencies": {
        "@crossbind/port-curl": "workspace:^",
        "@crossbind/port-openssl-wasi": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
