{
    "name": "@crossbind/port-curl-standalone-napi-darwin-arm64",
    "version": "2.0.0-beta.63",
    "nativeVersion": "8.22.0",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/curl#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(MIT OR NCSA) AND Apache-2.0 AND curl AND MIT",
    "description": "macOS arm64 addon of @crossbind/port-curl-standalone-napi, which npm installs on a matching machine.",
    "os": [
        "darwin"
    ],
    "cpu": [
        "arm64"
    ],
    "main": "dist/curl-standalone-napi.darwin-arm64.node",
    "files": [
        "dist/curl-standalone-napi.darwin-arm64.node",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin -a arm64 -e node -b release && crossbind licenses --platform darwin -e node --package",
        "clear": "rm -rf .crossbind dist",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-curl-darwin": "workspace:^",
        "@crossbind/port-curl-linux": "workspace:^",
        "@crossbind/port-curl-linuxmusl": "workspace:^",
        "@crossbind/port-curl-win32": "workspace:^"
    }
}
