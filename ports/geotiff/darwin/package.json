{
    "name": "@crossbind/port-geotiff-darwin",
    "version": "2.0.0-beta.63",
    "nativeVersion": "1.7.4",
    "description": "macOS build of the precompiled libgeotiff (GeoTIFF) library, built with crossbind. Use it together with the main package @crossbind/port-geotiff.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/geotiff#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "geotiff",
        "libgeotiff",
        "gis",
        "geospatial",
        "crossbind",
        "crossbind-port",
        "macos",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p darwin",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p darwin"
    },
    "dependencies": {
        "@crossbind/port-geotiff": "workspace:^",
        "@crossbind/port-proj-darwin": "workspace:^",
        "@crossbind/port-tiff-darwin": "workspace:^",
        "@crossbind/port-zlib-darwin": "workspace:^",
        "@crossbind/port-jpegturbo-darwin": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
