{
    "name": "@crossbind/port-geotiff-standalone-napi",
    "version": "2.0.0-beta.63",
    "nativeVersion": "1.7.4",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/geotiff#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(BSD-3-Clause OR GPL-2.0-only) AND (IJG AND BSD-3-Clause AND Zlib) AND (MIT OR NCSA) AND Apache-2.0 AND blessing AND libtiff AND MIT AND Zlib",
    "description": "geotiff for Node.js with nothing to build: prebuilt Node-API addons for macOS, Linux and Windows, built with crossbind.",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "exports": {
        ".": {
            "types": "./dist/node/napi.d.mts",
            "default": "./dist/node/napi.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.cjs",
        "dist/node",
        "dist/data",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin,linux,linuxmusl,win32 -e node -b release && crossbind licenses -e node --package",
        "clear": "rm -rf .crossbind dist",
        "e2e": "node ../../../scripts/e2e-node-package.mjs",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "optionalDependencies": {
        "@crossbind/port-geotiff-standalone-napi-darwin-arm64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-darwin-x64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-linux-arm64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-linux-x64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-linuxmusl-arm64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-linuxmusl-x64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-win32-arm64": "workspace:*",
        "@crossbind/port-geotiff-standalone-napi-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:*",
        "@crossbind/port-geotiff-darwin": "workspace:*",
        "@crossbind/port-geotiff-linux": "workspace:*",
        "@crossbind/port-geotiff-linuxmusl": "workspace:*",
        "@crossbind/port-geotiff-win32": "workspace:*"
    },
    "keywords": [
        "geotiff",
        "libgeotiff",
        "gis",
        "geospatial",
        "crossbind",
        "crossbind-port",
        "node",
        "node-api",
        "prebuilt"
    ]
}
