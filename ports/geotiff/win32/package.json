{
    "name": "@crossbind/port-geotiff-win32",
    "version": "2.0.0-beta.63",
    "nativeVersion": "1.7.4",
    "description": "Windows build of the precompiled libgeotiff (GeoTIFF) library, built with crossbind. Use it together with the main package @crossbind/port-geotiff.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/geotiff#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "geotiff",
        "libgeotiff",
        "gis",
        "geospatial",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-geotiff": "workspace:*",
        "@crossbind/port-proj-win32": "workspace:*",
        "@crossbind/port-tiff-win32": "workspace:*",
        "@crossbind/port-zlib-win32": "workspace:*",
        "@crossbind/port-jpegturbo-win32": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:*"
    }
}
