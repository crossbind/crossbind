{
    "name": "@crossbind/port-geos-ios",
    "version": "2.0.0-beta.50",
    "nativeVersion": "3.14.1",
    "description": "iOS build of the precompiled GEOS geometry library, built with crossbind. Use it together with the main package @crossbind/port-geos.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/geos#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "LGPL-2.1-or-later",
    "keywords": [
        "geos",
        "libgeos",
        "geometry",
        "gis",
        "crossbind",
        "crossbind-package",
        "ios",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p ios",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p ios"
    },
    "dependencies": {
        "@crossbind/port-geos": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}