{
    "name": "@crossbind/port-geos-android",
    "version": "2.0.0-beta.63",
    "nativeVersion": "3.15.0",
    "description": "Android build of the precompiled GEOS geometry library, built with crossbind. Use it together with the main package @crossbind/port-geos.",
    "homepage": "https://crossbind.dev/ports/geos/",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "LGPL-2.1-only",
    "keywords": [
        "geos",
        "libgeos",
        "geometry",
        "gis",
        "crossbind",
        "crossbind-port",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
    },
    "dependencies": {
        "@crossbind/port-geos": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}