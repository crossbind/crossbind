{
    "name": "@crossbind/port-geos-standalone-napi-darwin-arm64",
    "version": "2.0.0-beta.63",
    "nativeVersion": "3.15.0",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/geos#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "(MIT OR NCSA) AND LGPL-2.1-only AND MIT",
    "description": "macOS arm64 addon of @crossbind/port-geos-standalone-napi, which npm installs on a matching machine.",
    "os": [
        "darwin"
    ],
    "cpu": [
        "arm64"
    ],
    "main": "dist/geos-standalone-napi.darwin-arm64.node",
    "files": [
        "dist/geos-standalone-napi.darwin-arm64.node",
        "sbom.cdx.json"
    ],
    "scripts": {
        "build": "crossbind build -p darwin -a arm64 -e node -b release && crossbind licenses --platform darwin -e node --package",
        "clear": "rm -rf .crossbind dist",
        "prepack": "node ../../../scripts/check-node-package.mjs"
    },
    "devDependencies": {
        "crossbind": "workspace:*",
        "@crossbind/port-geos-darwin": "workspace:*",
        "@crossbind/port-geos-linux": "workspace:*",
        "@crossbind/port-geos-linuxmusl": "workspace:*",
        "@crossbind/port-geos-win32": "workspace:*"
    }
}
