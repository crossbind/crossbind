{
    "name": "@crossbind/port-geos-darwin",
    "version": "2.0.0-beta.62",
    "nativeVersion": "3.15.0",
    "description": "macOS build of the precompiled GEOS geometry library, built with crossbind. Use it together with the main package @crossbind/port-geos.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/geos#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "LGPL-2.1-only",
    "keywords": [
        "geos",
        "libgeos",
        "geometry",
        "gis",
        "crossbind",
        "crossbind-port",
        "macos",
        "node",
        "node-api"
    ],
    "scripts": {
        "build": "crossbind build -p darwin",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p darwin"
    },
    "dependencies": {
        "@crossbind/port-geos": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}
