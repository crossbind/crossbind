{
    "name": "@crossbind/port-zlib-win32",
    "version": "2.0.0-beta.63",
    "nativeVersion": "1.3.2",
    "description": "Windows build of the precompiled zlib library, built with crossbind. Use it together with the main package @crossbind/port-zlib.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/zlib#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "Zlib",
    "type": "module",
    "scripts": {
        "build": "crossbind build -p win32",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p win32"
    },
    "dependencies": {
        "@crossbind/port-zlib": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:*"
    },
    "keywords": [
        "zlib",
        "libz",
        "compression",
        "crossbind",
        "crossbind-port",
        "windows",
        "node",
        "node-api"
    ]
}
