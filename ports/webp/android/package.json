{
    "name": "@crossbind/port-webp-android",
    "version": "2.0.0-beta.53",
    "nativeVersion": "1.6.0",
    "description": "Android build of the precompiled WebP image library, built with crossbind. Use it together with the main package @crossbind/port-webp.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/webp#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "BSD-3-Clause",
    "keywords": [
        "webp",
        "libwebp",
        "image",
        "crossbind",
        "crossbind-port",
        "android",
        "react-native"
    ],
    "scripts": {
        "build": "crossbind build -p android",
        "clear": "rm -rf .crossbind dist *.xcframework",
        "prepublishOnly": "crossbind build -p android",
        "build:android": "crossbind build -p android"
    },
    "dependencies": {
        "@crossbind/port-webp": "workspace:^"
    },
    "devDependencies": {
        "crossbind": "workspace:^"
    }
}