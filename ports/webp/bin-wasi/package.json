{
    "name": "@crossbind/port-webp-bin-wasi",
    "version": "2.0.0-beta.50",
    "nativeVersion": "1.6.0",
    "description": "cwebp/dwebp/webpinfo prebuilt as WASI (wasm32-wasip3) command components.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/webp#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "type": "module",
    "license": "(Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (Apache-2.0 WITH LLVM-exception) AND BSD-3-Clause",
    "keywords": [
        "webp",
        "cli",
        "crossbind",
        "crossbind-port",
        "webassembly",
        "wasi",
        "wasmtime"
    ],
    "scripts": {
        "build": "crossbind build -p wasi -b release",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .crossbind dist",
        "prepublishOnly": "crossbind build -p wasi -b release && crossbind licenses --sbom"
    },
    "dependencies": {
        "@crossbind/port-webp": "workspace:^",
        "@crossbind/port-webp-wasi": "workspace:^",
        "crossbind": "workspace:^"
    },
    "bin": {
        "cwebp-wasi": "bin/cwebp-wasi.mjs",
        "dwebp-wasi": "bin/dwebp-wasi.mjs",
        "webpinfo-wasi": "bin/webpinfo-wasi.mjs"
    },
    "crossbind": {
        "provenance": {
            "recipe": {
                "name": "@crossbind/port-webp",
                "version": "2.0.0-beta.50",
                "nativeVersion": "1.6.0"
            },
            "source": {
                "url": "https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz",
                "sha256": "e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564"
            },
            "environment": {
                "builder": "host",
                "dockerImage": "ghcr.io/crossbind/web@sha256:c1d1d81a4775871cd90c8ac980e0a5f87cb7890822117f77be1c8345f51b1f47",
                "hostPlatform": "darwin-arm64",
                "toolchain": {
                    "name": "wasi-sdk",
                    "version": "34.0-rc.3+m",
                    "wasi-libc": "2e6fb9d8ee0c",
                    "llvm": "7196f931f212",
                    "llvm-version": "23.1.0",
                    "config": "f992bcc08219",
                    "clangSha256": "82a4a3fa013d14978f98452bb76213a3212ee4f5d7937e493ab40724061be570"
                }
            },
            "sbom": "dist/prebuilt/wasi-wasm32-st-release/sbom.cdx.json"
        }
    }
}
