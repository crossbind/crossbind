{
    "name": "@crossbind/port-iconv-node",
    "version": "2.0.0-beta.62",
    "nativeVersion": "1.19",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/ports/iconv#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "LGPL-2.1-or-later",
    "description": "iconv 1.19 for Node.js with nothing to build: prebuilt Node-API addons for macOS, Linux and Windows, built with crossbind.",
    "private": true,
    "type": "module",
    "exports": {
        "./*.h": {
            "types": "./dist/*.h.d.cts",
            "default": "./dist/*.h.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.cjs",
        "dist/**/*.d.cts",
        "dist/data"
    ],
    "scripts": {
        "build": "crossbind build -p darwin,linux,linuxmusl,win32 -e node -b release && node ../../../scripts/stage-node-addons.mjs",
        "clear": "rm -rf .crossbind dist",
        "e2e": "node ../../../scripts/e2e-node-package.mjs"
    },
    "optionalDependencies": {
        "@crossbind/port-iconv-node-darwin-arm64": "workspace:*",
        "@crossbind/port-iconv-node-darwin-x64": "workspace:*",
        "@crossbind/port-iconv-node-linux-arm64": "workspace:*",
        "@crossbind/port-iconv-node-linux-x64": "workspace:*",
        "@crossbind/port-iconv-node-linuxmusl-arm64": "workspace:*",
        "@crossbind/port-iconv-node-linuxmusl-x64": "workspace:*",
        "@crossbind/port-iconv-node-win32-arm64": "workspace:*",
        "@crossbind/port-iconv-node-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "@crossbind/port-iconv-darwin": "workspace:^",
        "@crossbind/port-iconv-linux": "workspace:^",
        "@crossbind/port-iconv-linuxmusl": "workspace:^",
        "@crossbind/port-iconv-win32": "workspace:^"
    },
    "keywords": [
        "iconv",
        "libiconv",
        "charset",
        "encoding",
        "crossbind",
        "crossbind-port",
        "node",
        "node-api",
        "prebuilt"
    ]
}
