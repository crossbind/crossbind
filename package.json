{
    "private": true,
    "scripts": {
        "build:ports": "pnpm --filter='@crossbind/port-*' run build",
        "build:examples": "pnpm --filter='@crossbind/example-*' run build",
        "promote:tags": "node scripts/promote-tags.js",
        "gate:local-promotion": "node scripts/gate-local-promotion.js",
        "gate:local-signature": "node scripts/gate-local-signature.js",
        "gate:referrers": "node scripts/gate-referrers.js",
        "gate:registry": "node scripts/gate-registry.js",
        "gate:local-sysroot": "node scripts/gate-local-sysroot.js",
        "gate:toolchain": "node scripts/gate-toolchain.js",
        "build:e2e": "pnpm --filter='@crossbind/e2e-web-*' --filter='@crossbind/e2e-cloud-*' --filter='@crossbind/e2e-backend-*' --filter='@crossbind/e2e-cli-*' run build",
        "build:examples:lib": "pnpm --filter='@crossbind/example-lib-*' run build",
        "build:examples:lib:wasm": "pnpm --filter='@crossbind/example-lib-*' run build:wasm",
        "build:examples:lib:android": "pnpm --filter='@crossbind/example-lib-*' run build:android",
        "build:examples:lib:ios": "pnpm --filter='@crossbind/example-lib-*' run build:ios",
        "build:examples:wasm": "pnpm --filter='@crossbind/example-web-*' run build && pnpm --filter='@crossbind/example-cloud-*' run build && pnpm --filter='@crossbind/example-backend-*' run build && pnpm run build:examples:lib:wasm",
        "build": "pnpm run build:ports && pnpm run build:examples",
        "clear:cache:examples": "rimraf -g '{examples,e2e}/*/.crossbind'",
        "clear:cache:ports": "rimraf -g 'ports/*/*/.crossbind'",
        "clear:cache": "pnpm run clear:cache:examples && pnpm run clear:cache:ports",
        "clear:dist:examples": "rimraf -g '{examples,e2e}/*/dist' '{examples,e2e}/*/*.xcframework'",
        "clear:dist:ports": "rimraf -g 'ports/*/*/dist' 'ports/*/*/*.xcframework'",
        "clear:dist:ports:android": "rimraf -g 'ports/*/android/dist'",
        "clear:dist": "pnpm run clear:dist:examples && pnpm run clear:dist:ports",
        "clear:pack": "rimraf -g 'ports/*/*/*.tgz' 'plugins/*/*.tgz' '{examples,e2e}/*/*.tgz' '{core,tooling}/*/*.tgz'",
        "clear:examples": "pnpm run clear:cache:examples && pnpm run clear:dist:examples",
        "clear:ports": "pnpm run clear:cache:ports && pnpm run clear:dist:ports",
        "clear:ports:android": "pnpm run clear:cache:ports && pnpm run clear:dist:ports:android",
        "clear": "pnpm run clear:cache && pnpm run clear:dist && pnpm run clear:pack",
        "lint": "eslint core/crossbind/src plugins",
        "pack:list": "find ports -name '*.tgz' -maxdepth 4 -type f",
        "ci:linux:build:port": "pnpm --filter=@crossbind/port-zlib-* run build",
        "ci:linux:build": "pnpm run build:examples && pnpm run ci:linux:build:port",
        "ci:linux:e2e": "pnpm -r --workspace-concurrency=1 --filter='@crossbind/example-*' e2e:prod",
        "ci:ios:e2e": "pnpm --filter=@crossbind/example-mobile-reactnative-cli run e2e:ios",
        "ci:android:e2e": "pnpm --filter=@crossbind/example-mobile-reactnative-cli run e2e:android",
        "ci:linux:e2e:wasi": "pnpm --filter=@crossbind/port-zlib-wasi e2e",
        "ci:windows:build": "pnpm run build:examples:lib:wasm && pnpm run build:examples:lib:android && pnpm run ci:linux:build:port",
        "ci:ios:build:port": "pnpm --filter=@crossbind/port-zlib-ios run build",
        "ci:macos:build": "pnpm run build:examples:lib:ios && pnpm run ci:ios:build:port",
        "e2e:dev": "pnpm -r --workspace-concurrency=1 e2e:dev",
        "e2e:prod": "pnpm -r --workspace-concurrency=1 e2e:prod",
        "e2e:ios": "pnpm -r --workspace-concurrency=1 e2e:ios",
        "e2e:android": "pnpm -r --workspace-concurrency=1 e2e:android",
        "e2e:mobile": "pnpm run e2e:ios && pnpm run e2e:android",
        "e2e:wasi": "pnpm -r --workspace-concurrency=1 --filter='@crossbind/port-*-wasi' e2e",
        "e2e": "pnpm run e2e:dev && pnpm run e2e:prod && pnpm run e2e:mobile",
        "e2e:templates": "node scripts/e2e-templates.js",
        "publish:examples": "pnpm --filter='@crossbind/example-*' publish --no-git-checks --tag beta",
        "publish:plugins": "pnpm --filter='@crossbind/plugin-*' publish --no-git-checks --tag beta",
        "publish:core": "pnpm --filter=crossbind publish --no-git-checks --tag beta",
        "publish:create": "pnpm --filter=create-crossbind publish --no-git-checks --tag beta",
        "publish:mcp": "pnpm --filter=@crossbind/mcp publish --no-git-checks --tag beta",
        "publish:all": "pnpm run publish:beta",
        "publish:beta": "pnpm --filter='@crossbind/*' --filter=crossbind publish --no-git-checks --tag beta --access public --report-summary",
        "check:dist": "node scripts/check-dist.js",
        "check:beta": "node scripts/check-beta-status.js",
        "check:deps": "node scripts/check-external-dependencies.js",
        "check:deps:strict": "node scripts/check-external-dependencies.js --check",
        "check:native": "node scripts/check-native-versions.js",
        "check:native:strict": "node scripts/check-native-versions.js --check",
        "check:wiring": "node scripts/check-dependency-wiring.js",
        "check:wiring:strict": "node scripts/check-dependency-wiring.js --check",
        "check:sources": "node scripts/check-source-hashes.js",
        "check:sources:strict": "node scripts/check-source-hashes.js --check",
        "check:publish": "node scripts/check-publish-hygiene.js",
        "check": "pnpm run lint && pnpm run check:dist && pnpm run check:deps:strict && pnpm run check:native:strict && pnpm run check:wiring:strict && pnpm run check:sources:strict && pnpm run check:publish",
        "help": "node scripts/help.js",
        "doctor": "bash scripts/doctor.sh",
        "scaffold:port": "node scripts/scaffold-package.js",
        "test": "pnpm --filter crossbind test",
        "test:watch": "pnpm --filter crossbind test:watch",
        "test:coverage": "pnpm --filter crossbind test:coverage"
    },
    "devDependencies": {
        "crossbind": "workspace:^",
        "prettier": "^3.9.6",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.1",
        "globals": "^17.9.0",
        "@playwright/test": "^1.62.1",
        "rimraf": "^6.1.3"
    },
    "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}