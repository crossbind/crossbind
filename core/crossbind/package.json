{
    "name": "crossbind",
    "version": "2.0.0-beta.51",
    "license": "MIT",
    "homepage": "https://crossbind.dev",
    "repository": "https://github.com/crossbind/crossbind.git",
    "description": "Bind C++ to JavaScript without extra code. crossbind supports WebAssembly and React Native for cross-platform compatibility.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "crossbind": "./src/bin.js"
    },
    "main": "src/index.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-virtual": "^3.0.2",
        "comlink": "^4.4.2",
        "commander": "^15.0.0",
        "glob": "^13.0.6",
        "log-update": "^8.0.0",
        "picocolors": "^1.1.1",
        "replace": "^1.2.2",
        "rollup": "^4.62.4",
        "spdx-expression-parse": "^5.0.0",
        "upath": "^3.0.8"
    },
    "keywords": [
        "webassembly",
        "react-native",
        "bind",
        "c++",
        "emscripten",
        "embind",
        "swig",
        "android",
        "ios",
        "mobile"
    ]
}