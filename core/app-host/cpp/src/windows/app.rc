#include <winver.h>
// The app's name and version, which crossbind writes into the build directory from crossbind.config.js.
#include "crossbind_app.h"

// The app's manifest (resource 1 of type RT_MANIFEST) makes its narrow strings UTF-8: the paths and the environment
// the host and the libraries it links pass to the C runtime and to Windows, such as a user folder with a non-ASCII name.
// It takes version 6 of the common controls as well, whose task dialog shows the app's message dialogs.
1 24 "app.manifest"

#ifdef CROSSBIND_APP_ICON
// The app's icon, which crossbind writes beside crossbind_app.h, as IDI_APPLICATION: webview gives its window that one,
// and Explorer shows it for the executable.
32512 ICON "icon.ico"
#endif

// What Explorer shows in the executable's details, and Task Manager by its process.
VS_VERSION_INFO VERSIONINFO
FILEVERSION CROSSBIND_APP_VERSION_NUMBERS
PRODUCTVERSION CROSSBIND_APP_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", CROSSBIND_APP_NAME
            VALUE "FileVersion", CROSSBIND_APP_VERSION
#ifdef CROSSBIND_APP_COPYRIGHT
            VALUE "LegalCopyright", CROSSBIND_APP_COPYRIGHT
#endif
            VALUE "ProductName", CROSSBIND_APP_NAME
            VALUE "ProductVersion", CROSSBIND_APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
