{
    "name": "@crossbind/plugin-react-native",
    "version": "2.0.0-beta.53",
    "description": "crossbind React Native plugin: A tool for seamless C++ integration with React Native and Expo.",
    "homepage": "https://github.com/crossbind/crossbind/tree/main/plugins/react-native#readme",
    "repository": "https://github.com/crossbind/crossbind.git",
    "license": "MIT",
    "main": "js/index.js",
    "type": "module",
    "codegenConfig": {
        "name": "RNCrossbindSpec",
        "type": "modules",
        "jsSrcsDir": "spec",
        "android": {
            "javaPackageName": "com.jsi.lib"
        }
    },
    "peerDependencies": {
        "react-native": "*",
        "metro": "*",
        "@expo/config-plugins": "*"
    },
    "peerDependenciesMeta": {
        "@expo/config-plugins": {
            "optional": true
        }
    },
    "dependencies": {
        "crossbind": "workspace:^",
        "@crossbind/plugin-metro": "workspace:^",
        "@crossbind/core-embind-jsi": "workspace:^",
        "@babel/runtime": "^7.29.7",
        "upath": "^3.0.8",
        "@crossbind/core-embind-rust": "workspace:^"
    },
    "keywords": [
        "crossbind-plugin",
        "react-native",
        "expo",
        "bind",
        "c++",
        "android",
        "ios",
        "mobile"
    ]
}
